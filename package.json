{
  "name": "chen-er",
  "version": "0.1.0",
  "description": "Agent-first Chen ER diagrams: write the model in YAML, get a laid-out diagram and course-aware lint.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "gen:metrics": "tsx scripts/gen-metrics.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "chen": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "build:viewer": "vite build",
    "serve": "tsx src/cli/index.ts serve",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "er-diagram",
    "chen-notation",
    "database",
    "erd",
    "agent",
    "mcp",
    "yaml"
  ],
  "author": "Ali Enes Adaklı",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/node": "^26.6.4",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "bin": {
    "chen": "./bin/chen.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "schema",
    "skills",
    "docs",
    "examples/*.er.yaml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enesadakli/chen-er.git"
  },
  "homepage": "https://github.com/enesadakli/chen-er#readme",
  "bugs": {
    "url": "https://github.com/enesadakli/chen-er/issues"
  }
}
